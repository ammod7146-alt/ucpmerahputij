# Kredensial database MySQL (harus bisa diakses dari internet kalau di-deploy ke Vercel)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=lisa

# Set "true" kalau database cloud kamu mewajibkan SSL (PlanetScale, Railway, dll biasanya iya)
DB_SSL=false

# String acak panjang buat menandatangani session login. GANTI dengan string acakmu sendiri.
# Bisa generate lewat: openssl rand -hex 32
SESSION_SECRET=
